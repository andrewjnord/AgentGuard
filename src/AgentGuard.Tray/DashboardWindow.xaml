<Window x:Class="AgentGuard.Tray.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="AgentGuard" Width="1280" Height="820" MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterScreen">
  <Grid>
    <wv2:WebView2 x:Name="Web"/>
    <TextBlock x:Name="Status" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14"
               Foreground="{StaticResource Muted}" Text="Opening the AgentGuard dashboard…"/>
  </Grid>
</Window>
