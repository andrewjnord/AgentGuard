<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <!-- The UpgradeCode identifies AgentGuard across versions: never change it. -->
  <Package Name="AgentGuard" Manufacturer="AgentGuard" Version="$(var.ProductVersion)"
           UpgradeCode="{5EA980B9-DAC3-494A-82AA-7A52B627AF56}" Scope="perMachine" Compressed="yes">

    <SummaryInformation Description="AgentGuard: governance and audit for AI agents" />
    <MajorUpgrade DowngradeErrorMessage="A newer version of AgentGuard is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />
    <Launch Condition="VersionNT64 AND VersionNT &gt;= 603" Message="AgentGuard needs 64-bit Windows 10 or later." />

    <!-- Register the Claude Code PreToolUse hook machine-wide (msiexec ... INSTALLCLAUDEHOOK=0 to skip). -->
    <Property Id="INSTALLCLAUDEHOOK" Value="1" Secure="yes" />
    <Property Id="ARPHELPLINK" Value="https://github.com/andrewjnord/AgentGuard" />
    <Property Id="ARPNOMODIFY" Value="1" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="AgentGuard" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppMenuFolder" Name="AgentGuard" />
    </StandardDirectory>

    <Feature Id="Main" Title="AgentGuard" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentGroupRef Id="ServiceComponents" />
      <ComponentGroupRef Id="TrayComponents" />
    </Feature>

    <!-- Everything published, except the service executable, which needs its own component for ServiceInstall. -->
    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Files Include="!(bindpath.app)**">
        <Exclude Files="!(bindpath.app)AgentGuard.Service.exe" />
      </Files>
    </ComponentGroup>

    <ComponentGroup Id="ServiceComponents" Directory="INSTALLFOLDER">
      <Component Id="ServiceExe">
        <File Id="ServiceExe" Source="!(bindpath.app)AgentGuard.Service.exe" KeyPath="yes" />
        <ServiceInstall Id="AgentGuardService" Name="AgentGuard" DisplayName="AgentGuard"
                        Description="Records and governs what AI agents do on this computer."
                        Type="ownProcess" Start="auto" ErrorControl="normal" Account="LocalSystem" Vital="yes">
          <util:ServiceConfig FirstFailureActionType="restart" SecondFailureActionType="restart"
                              ThirdFailureActionType="restart" RestartServiceDelayInSeconds="10" ResetPeriodInDays="1" />
        </ServiceInstall>
        <ServiceControl Id="AgentGuardServiceControl" Name="AgentGuard" Start="install" Stop="both" Remove="uninstall" Wait="yes" />
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="TrayComponents">
      <!-- The tray starts for every user at sign-in. -->
      <Component Id="TrayAutostart" Directory="INSTALLFOLDER">
        <RegistryValue Root="HKLM" Key="SOFTWARE\Microsoft\Windows\CurrentVersion\Run" Name="AgentGuard"
                       Type="string" Value="&quot;[INSTALLFOLDER]AgentGuard.Tray.exe&quot;" KeyPath="yes" />
      </Component>
      <Component Id="StartMenuShortcut" Directory="AppMenuFolder">
        <Shortcut Id="TrayShortcut" Name="AgentGuard" Description="Open the AgentGuard dashboard"
                  Target="[INSTALLFOLDER]AgentGuard.Tray.exe" Arguments="--open" WorkingDirectory="INSTALLFOLDER" />
        <RemoveFolder Id="RemoveAppMenuFolder" On="uninstall" />
        <!-- Windows Installer tracks Start menu shortcuts with a current-user key (ICE38/ICE43/ICE57). -->
        <RegistryValue Root="HKCU" Key="Software\AgentGuard" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!-- Install: register the Claude Code hook once the files are in place. -->
    <SetProperty Id="RegisterClaudeHook" Sequence="execute" Before="RegisterClaudeHook"
                 Value="&quot;[INSTALLFOLDER]agentguard-hook.exe&quot; install --managed"
                 Condition="NOT REMOVE AND INSTALLCLAUDEHOOK = 1" />
    <CustomAction Id="RegisterClaudeHook" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixQuietExec"
                  Execute="deferred" Impersonate="no" Return="ignore" />

    <!--
      Uninstall (not upgrade): with the service stopped and before files are removed, restore MCP client configs that
      point at the proxy and remove the Claude Code hook, so no client is left pointing at a deleted executable.
      The data folder (%ProgramData%\AgentGuard: audit log, policy history) is kept as evidence.
    -->
    <SetProperty Id="CleanupIntegrations" Sequence="execute" Before="CleanupIntegrations"
                 Value="&quot;[INSTALLFOLDER]agentguard.exe&quot; cleanup-integrations"
                 Condition="REMOVE = &quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
    <CustomAction Id="CleanupIntegrations" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixQuietExec"
                  Execute="deferred" Impersonate="no" Return="ignore" />

    <!--
      Start (or restart) the tray once an interactive install, upgrade or repair has finished. This runs in the UI
      sequence, which belongs to the signed-in user's own unelevated msiexec process, so the tray is not started
      elevated. Silent installs (/qn, used by fleet tools running as SYSTEM) have no UI sequence and skip it; the tray
      then starts at the user's next sign-in from the Run key. "--background" makes a second copy exit quietly
      instead of opening the dashboard.
    -->
    <CustomAction Id="LaunchTray" Directory="INSTALLFOLDER" ExeCommand="&quot;[INSTALLFOLDER]AgentGuard.Tray.exe&quot; --background"
                  Execute="immediate" Impersonate="yes" Return="asyncNoWait" />
    <InstallUISequence>
      <Custom Action="LaunchTray" After="ExecuteAction" Condition="NOT (REMOVE = &quot;ALL&quot;)" />
    </InstallUISequence>

    <InstallExecuteSequence>
      <Custom Action="RegisterClaudeHook" After="InstallFiles" Condition="NOT REMOVE AND INSTALLCLAUDEHOOK = 1" />
      <Custom Action="CleanupIntegrations" After="StopServices" Condition="REMOVE = &quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
    </InstallExecuteSequence>
  </Package>
</Wix>
